# Command-line tools MP4Studio drives. Install with: brew bundle
brew "ffmpeg"        # ffmpeg, ffprobe, ffplay: converting, remuxing, track info, preview
brew "mkvtoolnix"    # mkvmerge, mkvextract: MKV editing, splitting, joining, extraction
brew "gpac"          # MP4Box: MP4/M4V editing and joining
brew "atomicparsley" # iTunes-style MP4 metadata and artwork
brew "media-info"    # mediainfo (optional): the Info panel
